{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["cad-guard"],
  "disabledMcpjsonServers": ["cad-guard-ho-so"],
  "allowedMcpServers": [
    { "serverName": "cad-guard" },
    { "serverName": "cad-guard-ho-so" }
  ],
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "mcp__cad-guard__*",
      "mcp__cad-guard-ho-so__*",
      "Skill"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "Monitor",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "LSP",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Workflow",
      "Artifact",
      "SendUserFile",
      "RemoteTrigger",
      "CronCreate",
      "EnterWorktree"
    ]
  }
}
